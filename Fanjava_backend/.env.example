# Copiez ce fichier en ".env" (jamais commité) et renseignez les vraies valeurs.
# Génération d'une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

DB_NAME=marketplace_db
DB_USER=django_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# URL du frontend (liens des e-mails). En local : http://localhost:5173
FRONTEND_URL=https://fanjava.mg

# E-mail (laisser EMAIL_HOST vide = les e-mails sont seulement écrits dans les logs)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fanjava <no-reply@fanjava.mg>
